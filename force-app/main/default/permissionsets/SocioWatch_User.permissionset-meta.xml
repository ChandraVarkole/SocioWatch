<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>
        Standard SocioWatch access for viewing configuration information,
        reviewing actionable mentions, updating follow-up fields, and using chat.
    </description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>SocioWatch User</label>

    <customPermissions>
        <enabled>true</enabled>
        <name>SocioWatch_Use_Chat</name>
    </customPermissions>

    <!-- Configuration is read-only for standard users -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>SocioWatch_Configuration__c</object>
        <viewAllFields>false</viewAllFields>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

    <!-- Users can review and update actionable mention records -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>SocioWatch_Mention__c</object>
        <viewAllFields>false</viewAllFields>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

    <!-- Read-only configuration fields -->
    <fieldPermissions>
        <editable>false</editable>
        <field>SocioWatch_Configuration__c.Alert_Id__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>SocioWatch_Configuration__c.AWS_Company_Id__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>SocioWatch_Configuration__c.Company_Name__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>SocioWatch_Configuration__c.Keywords__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>SocioWatch_Configuration__c.Last_Successful_Sync__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>SocioWatch_Configuration__c.Last_Sync_Status__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>SocioWatch_Configuration__c.Sync_Enabled__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <!-- Read-only imported mention data -->
    <fieldPermissions>
        <editable>false</editable>
        <field>SocioWatch_Mention__c.Action_Reason__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>SocioWatch_Mention__c.Actionable_Type__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>SocioWatch_Mention__c.Alert_Id__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>SocioWatch_Mention__c.Author_Name__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>SocioWatch_Mention__c.Configuration__c</field>
        <readable>true</readable>
