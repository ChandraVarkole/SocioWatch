<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>
        Standard SocioWatch access for viewing configuration information,
        reviewing actionable mentions, updating follow-up fields, and using chat.
    </description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>SocioWatch User</label>

    <applicationVisibilities>
        <application>SocioWatch</application>
        <visible>true</visible>
    </applicationVisibilities>

    <classAccesses>
        <apexClass>SocioWatchChatController</apexClass>
        <enabled>true</enabled>
    </classAccesses>

    <customPermissions>
        <enabled>true</enabled>
        <name>SocioWatch_Use_Chat</name>
    </customPermissions>

    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>SocioWatch_Configuration__c</object>
        <viewAllFields>false</viewAllFields>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>SocioWatch_Mention__c</object>
        <viewAllFields>false</viewAllFields>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

    <!-- Non-required Configuration fields -->
    <fieldPermissions>
        <editable>false</editable>
        <field>SocioWatch_Configuration__c.AWS_Company_Id__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>SocioWatch_Configuration__c.Keywords__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>SocioWatch_Configuration__c.Last_Successful_Sync__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>SocioWatch_Configuration__c.Last_Sync_Status__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>SocioWatch_Configuration__c.Sync_Enabled__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <!-- Read-only imported Mention fields -->
    <fieldPermissions>
        <editable>false</editable>
        <field>SocioWatch_Mention__c.Action_Reason__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>SocioWatch_Mention__c.Actionable_Type__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>SocioWatch_Mention__c.Alert_Id__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>SocioWatch_Mention__c.Author_Name__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>SocioWatch_Mention__c.Language__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>SocioWatch_Mention__c.Mention_Text__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>SocioWatch_Mention__c.Recommended_Action__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>SocioWatch_Mention__c.Sentiment__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>SocioWatch_Mention__c.Source__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>SocioWatch_Mention__c.Source_URL__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>SocioWatch_Mention__c.Sync_Run_Id__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>SocioWatch_Mention__c.Title__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <!-- User-managed workflow fields -->
    <fieldPermissions>
        <editable>true</editable>
        <field>SocioWatch_Mention__c.Assigned_To__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>SocioWatch_Mention__c.Priority__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>SocioWatch_Mention__c.Response_Draft__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>SocioWatch_Mention__c.Status__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <tabSettings>
        <tab>SocioWatch_Mention__c</tab>
        <visibility>Visible</visibility>
    </tabSettings>

    <tabSettings>
        <tab>SocioWatch_Chat</tab>
        <visibility>Visible</visibility>
    </tabSettings>

    <tabSettings>
        <tab>SocioWatch_Settings</tab>
        <visibility>None</visibility>
    </tabSettings>

    <tabSettings>
        <tab>SocioWatch_Configuration__c</tab>
        <visibility>None</visibility>
    </tabSettings>
</PermissionSet>